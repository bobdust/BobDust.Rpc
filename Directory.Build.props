<Project>
    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <EnableUnsafeBinaryFormatterSerialization>true</EnableUnsafeBinaryFormatterSerialization>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        <Version>0.10.2</Version>
        <Authors>BobDust</Authors>
        <Company>BobDust</Company>
        <Copyright>Copyright ©BobDust 2012</Copyright>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <Description>BobDust libraries</Description>
        <Product>BobDust.Rpc</Product>

        <!-- Assembly versions -->
        <AssemblyVersion>0.10.2</AssemblyVersion>

        <!-- FileVersion may include build number from CI -->
        <FileVersion>0.10.2</FileVersion>
        <!-- Specify the custom nuspec file if not done at project level -->
        <NuspecFile>$(MSBuildThisFileDirectory)package.nuspec</NuspecFile>
    </PropertyGroup>
    <ItemGroup>
        <None Include="..\README.md" Pack="true" PackagePath="\" />
    </ItemGroup>
</Project>